# ============================================================
# SECURITY — Sensitive files that MUST NOT be committed
# ============================================================

# Android: local SDK path (device-specific, contains absolute paths)
android/local.properties

# Android: keystore signing credentials (NEVER commit)
android/key.properties
*.jks
*.keystore

# Firebase configs (contain API keys)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Environment / secrets
.env
.env.*
!.env.example

# Generated lock files for packages (keep pubspec.lock for reproducibility)
# pubspec.lock — intentionally NOT excluded
